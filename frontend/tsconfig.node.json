{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "e2e/**/*.ts",
    "eslint.config.*"
  ],
  "compilerOptions": {

    "module": "preserve",
    "moduleResolution": "bundler",


    "types": ["node"],


    "noEmit": true,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
