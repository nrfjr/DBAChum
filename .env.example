# DBAChum Docker Compose configuration

# Public HTTP port for the web UI.
DBACHUM_PORT=8080

# Backend/application settings.
APP_VERSION=2.0.0
LOG_LEVEL=INFO
SESSION_COOKIE_NAME=dbachum_session
SESSION_HOURS=12
COOKIE_SECURE=false

# Generate with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CONNECTION_ENCRYPTION_KEY=

# MongoDB is only exposed to the internal Compose network.
MONGODB_DATABASE=dbachum

# Historical monitoring.
METRICS_COLLECTOR_ENABLED=true
METRICS_COLLECTOR_INTERVAL_SECONDS=60
METRICS_RETENTION_DAYS=30

# Normally unnecessary because frontend -> API is same-origin through Nginx.
# Change this only if you intentionally access the API directly from another origin.
CORS_ORIGINS=http://localhost:8080
