APP_NAME=DBAChum API
APP_VERSION=2.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dbachum

SESSION_COOKIE_NAME=dbachum_session
SESSION_HOURS=12
COOKIE_SECURE=false

# setup.ps1 generates a real key when backend/.env does not exist.
CONNECTION_ENCRYPTION_KEY=replace-me

METRICS_COLLECTOR_ENABLED=true
METRICS_COLLECTOR_INTERVAL_SECONDS=60
METRICS_RETENTION_DAYS=30

# The production frontend is same-origin with the API, so CORS is normally
# irrelevant. Keep localhost entries for direct administrative testing.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
