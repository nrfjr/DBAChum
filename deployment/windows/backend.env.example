APP_NAME=DBAChum API
APP_VERSION=2.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1
API_DOCS_ENABLED=false

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dbachum

SESSION_COOKIE_NAME=dbachum_session
SESSION_HOURS=12
COOKIE_SECURE=false

# setup.ps1 generates a real key when backend/.env does not exist.
CONNECTION_ENCRYPTION_KEY=replace-me

METRICS_COLLECTOR_ENABLED=true
METRICS_COLLECTOR_INTERVAL_SECONDS=60
METRICS_RETENTION_DAYS=30

# setup.ps1 replaces this marker with localhost, the Windows computer name,
# and detected local IPv4 addresses. Add any DNS alias/FQDN used by clients.
TRUSTED_HOSTS=__TRUSTED_HOSTS__

# Production frontend/API are same-origin, so CORS is disabled by default.
# Add explicit origins only when a separate trusted frontend needs API access.
CORS_ORIGINS=
