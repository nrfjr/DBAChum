APP_NAME=DBAChum API
APP_VERSION=2.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1
API_DOCS_ENABLED=true

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dbachum

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
TRUSTED_HOSTS=localhost,127.0.0.1

SESSION_COOKIE_NAME=dbachum_session
SESSION_HOURS=12
COOKIE_SECURE=false

CONNECTION_ENCRYPTION_KEY=generate-a-fernet-key

# Oracle 10g requires Thick mode with a compatible OCI client.
ORACLE_DRIVER_MODE=thin
ORACLE_CLIENT_LIB_DIR=

METRICS_COLLECTOR_ENABLED=true
METRICS_COLLECTOR_INTERVAL_SECONDS=60
METRICS_RETENTION_DAYS=30
