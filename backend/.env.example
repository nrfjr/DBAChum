APP_NAME=DBAChum API
APP_VERSION=2.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dbachum

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

SESSION_COOKIE_NAME=dbachum_session
SESSION_HOURS=12
COOKIE_SECURE=false

CONNECTION_ENCRYPTION_KEY=generate-a-fernet-key